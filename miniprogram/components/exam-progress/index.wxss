.exam-progress-section {
  margin: 32rpx;
}

.exam-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 20rpx 0;
}

.exam-progress-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #000;
}

.exam-progress-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  padding: 28rpx 32rpx;
}

.exam-progress-card.clickable:active {
  opacity: 0.9;
}

.exam-progress-card:last-child {
  margin-bottom: 0;
}

.exam-card-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #2563eb;
  border-radius: 0 8rpx 8rpx 0;
}

.exam-card-bar.exam-card-bar-passed {
  background: #07C160;
}

.exam-card-inner {
  flex: 1;
  min-width: 0;
}

.exam-progress-card.has-time .exam-card-inner {
  margin-left: 16rpx;
}

.exam-card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.exam-card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #334155;
  flex: 1;
  min-width: 0;
}

.exam-countdown-badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  background: #93c5fd;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-countdown-badge-text {
  font-size: 22rpx;
  color: #1e40af;
}

.exam-countdown-badge.exam-badge-passed {
  background: #07C160;
}

.exam-countdown-badge.exam-badge-passed .exam-countdown-badge-text {
  color: #fff;
}

.exam-card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.exam-card-meta .md-icon {
  flex-shrink: 0;
}

.exam-meta-label {
  font-size: 26rpx;
  color: #64748b;
}

.exam-meta-time {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 500;
}

.exam-card-meta-passed .exam-meta-time {
  color: #94a3b8;
}

.exam-card-meta-unset {
  color: #94a3b8;
}

.exam-meta-placeholder {
  font-size: 26rpx;
  color: #94a3b8;
}

.exam-card-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
  flex-shrink: 0;
  margin-left: 16rpx;
}
