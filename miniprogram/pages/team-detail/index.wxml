<scroll-view scroll-y class="page hide-scrollbar" enhanced show-scrollbar="{{false}}">
  <view class="error-block" wx:if="{{error}}">{{error}}</view>

  <!-- 所属团队：团队长 + 成员列表 -->
  <block wx:if="{{mode === 'leaderTeam' && !loading}}">
    <view class="leader-wrap" wx:if="{{leader}}">
      <text class="members-title">团队长</text>
      <view class="leader-section">
        <view class="profile-row">
          <image class="avatar" src="{{leader.avatar}}" mode="aspectFill" />
          <text class="name">{{leader.nickname}}</text>
        </view>
        <view class="stats-grid">
          <view wx:for="{{leaderStats}}" wx:key="label" class="stat-item">
            <text class="stat-label">{{item.label}}</text>
            <text class="stat-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="members-section">
      <text class="members-title">团队成员</text>
      <view class="member-list" wx:if="{{leaderTeamMembers.length > 0}}">
        <view wx:for="{{leaderTeamMembers}}" wx:key="_openid" class="member-item">
          <view class="member-left">
            <image class="member-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view class="member-info">
              <text class="member-name">{{item.name}}<text class="member-tag" wx:if="{{item.isMe}}"> 我</text></text>
              <view class="progress-dots">
                <view wx:for="{{item.dots}}" wx:for-item="d" wx:key="num" class="dot {{d.passed ? 'passed' : ''}}">{{d.num}}</view>
              </view>
            </view>
          </view>
          <view class="member-right" wx:if="{{item.teamSize > 0}}">
            <view class="member-badge"><text class="badge-icon">👥</text><text class="badge-text">{{item.teamSize}}</text></view>
          </view>
        </view>
      </view>
      <view class="member-list empty" wx:else>
        <text class="empty-text">暂无团队成员</text>
      </view>
    </view>
  </block>

  <!-- 某成员的团队：与团队主页结构一致 -->
  <block wx:if="{{mode === 'member' && !loading}}">
    <view class="stats-grid">
      <view wx:for="{{stats}}" wx:key="label" class="stat-item">
        <text class="stat-label">{{item.label}}</text>
        <text class="stat-value">{{item.value}}</text>
      </view>
    </view>
    <view class="leader-card" wx:if="{{hasLeader && leaderCard}}">
      <view class="leader-left">
        <image class="leader-avatar" src="{{leaderCard.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=leader'}}" mode="aspectFill" />
        <text class="leader-name">{{leaderCard.nickname}}</text>
      </view>
      <view class="leader-right">
        <view class="leader-badge">
          <text class="badge-icon">👥</text>
          <text class="badge-text">{{leaderCard.teamSize}}</text>
        </view>
      </view>
    </view>
    <view class="members-section">
      <text class="members-title">团队成员</text>
      <view class="member-list" wx:if="{{directMembers.length > 0}}">
        <view
          wx:for="{{directMembers}}"
          wx:key="inviteCode"
          class="member-item {{item.hasSubordinates ? 'clickable' : ''}}"
          data-item="{{item}}"
          bindtap="onMemberTap"
        >
          <view class="member-left">
            <image class="member-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view class="member-info">
              <text class="member-name">{{item.name}}</text>
              <view class="progress-dots">
                <view wx:for="{{item.dots}}" wx:for-item="d" wx:key="num" class="dot {{d.passed ? 'passed' : ''}}">{{d.num}}</view>
              </view>
            </view>
          </view>
          <view class="member-right" wx:if="{{item.hasSubordinates}}">
            <view class="member-badge"><text>👥</text><text>{{item.teamSize}}</text></view>
            <text class="member-arrow">›</text>
          </view>
        </view>
      </view>
      <view class="member-list empty" wx:else>
        <text class="empty-text">暂无直属成员</text>
      </view>
    </view>
  </block>

  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
</scroll-view>
