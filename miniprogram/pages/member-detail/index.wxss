.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #F8FAFC;
}

.hide-scrollbar::-webkit-scrollbar {
  display: none;
}

.error-block {
  padding: 32rpx;
  text-align: center;
  color: #ef4444;
  font-size: 28rpx;
}

.loading-tip {
  padding: 80rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.info-card {
  padding: 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.info-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f1f5f9;
}

.info-main {
  flex: 1;
  min-width: 0;
}

.info-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #000;
  display: block;
  margin-bottom: 12rpx;
}

.info-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.info-meta-text {
  font-size: 26rpx;
  color: #64748b;
}

.row-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.row-icon.phone-icon {
  background: rgba(59, 130, 246, 0.12);
}

.row-icon.identity-icon {
  background: rgba(34, 197, 94, 0.12);
}

.row-content {
  flex: 1;
  min-width: 0;
}

.row-label {
  font-size: 24rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 4rpx;
}

.row-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #000;
  display: block;
}

.row-value-empty {
  font-size: 24rpx;
  font-style: italic;
  font-weight: normal;
  color: #64748b;
}

.row-extra {
  font-size: 24rpx;
  color: #d97706;
  display: block;
  margin-top: 4rpx;
}

.row-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  flex-shrink: 0;
}
