<view class="page">
  <view class="nav-bar">
    <view class="nav-bar-inner" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-back" bindtap="onNavBack">
        <text class="nav-back-text">‹</text>
      </view>
      <text class="nav-title">注册登录</text>
      <view class="nav-placeholder" />
    </view>
  </view>
  <view class="card">
    <view class="title">欢迎使用 HKIIQE</view>
    <view class="desc">请先完成微信头像与昵称授权，再进行登录或注册</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>

    <!-- 头像昵称填写（微信官方授权能力） -->
    <view class="auth-section">
      <view class="avatar-row">
        <view class="avatar-wrap">
          <view class="avatar-btn-box">
            <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
              <image class="avatar-img" wx:if="{{avatarDisplay}}" src="{{avatarDisplay}}" mode="aspectFill" />
              <view class="avatar-placeholder" wx:elif="{{!avatarDisplay}}">
                <text class="avatar-tip">点击选择头像</text>
              </view>
            </button>
          </view>
        </view>
      </view>
      <view class="nickname-row">
        <text class="label">昵称</text>
        <input
          class="nickname-input"
          type="nickname"
          placeholder="请填写昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
      <view class="invite-code-row" wx:if="{{isNewUser === true || isNewUser === null || inviteCodeReadonly}}">
        <text class="label">邀请码（必填）</text>
        <input
          wx:if="{{inviteCodeReadonly}}"
          class="nickname-input invite-code-readonly"
          type="text"
          value="{{inviteCode}}"
          disabled
          placeholder=""
        />
        <input
          wx:else
          class="nickname-input"
          type="text"
          placeholder="请输入6位数字和字母组合"
          value="{{inviteCode}}"
          maxlength="6"
          bindinput="onInviteCodeInput"
        />
      </view>
    </view>

    <view class="btn-login-wrap">
      <button
        class="btn-login"
        style="margin: 0; width: 100%;"
        type="primary"
        loading="{{loading}}"
        disabled="{{loading || !avatarDisplay || !nickname || ((isNewUser === true || isNewUser === null) && inviteCode.length !== 6)}}"
        bindtap="onConfirmLogin"
      >
        微信一键授权登录
      </button>
    </view>
    <view class="hint" wx:if="{{!avatarDisplay}}">请先选择头像</view>
    <view class="hint" wx:elif="{{!nickname}}">请填写昵称</view>
    <view class="hint" wx:elif="{{(isNewUser === true || isNewUser === null) && inviteCode.length !== 6}}">请填写6位邀请码</view>
  </view>
</view>
