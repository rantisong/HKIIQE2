<view class="page">
  <view class="nav-bar">
    <view class="nav-bar-inner" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-back" bindtap="onNavBack">
        <text class="nav-back-text">‹ 返回</text>
      </view>
      <text class="nav-title">登录 / 注册</text>
      <view class="nav-placeholder" />
    </view>
  </view>
  <view class="card">
    <view class="title">欢迎使用 HKIIQE</view>
    <view class="desc">请先完成微信头像与昵称授权，再进行登录或注册</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>

    <!-- 头像昵称填写（微信官方授权能力） -->
    <view class="auth-section">
      <view class="avatar-row">
        <text class="label">头像</text>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-img" wx:if="{{avatarDisplay}}" src="{{avatarDisplay}}" mode="aspectFill" />
          <view class="avatar-placeholder" wx:elif="{{!avatarDisplay}}">
            <text class="avatar-tip">点击选择头像</text>
          </view>
        </button>
      </view>
      <view class="nickname-row">
        <text class="label">昵称</text>
        <input
          class="nickname-input"
          type="nickname"
          placeholder="请填写昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
    </view>

    <button
      class="btn-login"
      type="primary"
      loading="{{loading}}"
      disabled="{{loading || !nickname}}"
      bindtap="onConfirmLogin"
    >
      确认授权并登录
    </button>
    <view class="hint" wx:if="{{!nickname}}">请至少填写昵称</view>
  </view>
</view>
