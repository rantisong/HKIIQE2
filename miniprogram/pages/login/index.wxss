.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 48rpx;
  padding-top: calc(44px + constant(safe-area-inset-top));
  padding-top: calc(44px + env(safe-area-inset-top));
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-bar-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.nav-back {
  min-width: 120rpx;
  padding: 8rpx 0;
}

.nav-back-text {
  font-size: 32rpx;
  color: #07C160;
}

.nav-title {
  font-size: 24rpx;
  font-weight: normal;
  color: #000;
}

.nav-placeholder {
  min-width: 120rpx;
}

.card {
  width: 100%;
  max-width: 560rpx;
  padding: 64rpx 48rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #000;
  text-align: center;
  margin-bottom: 24rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 48rpx;
}

.error {
  font-size: 26rpx;
  color: #ee0a24;
  text-align: center;
  margin-bottom: 24rpx;
  min-height: 36rpx;
}

.auth-section {
  margin-bottom: 40rpx;
}

.avatar-row,
.nickname-row,
.invite-code-row {
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.avatar-row .label,
.nickname-row .label,
.invite-code-row .label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.avatar-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.avatar-btn-box {
  width: 160rpx;
  height: 160rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  border: none;
  display: block;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
  background: #f0f0f0;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.invite-code-readonly {
  background: #f0f0f0;
  color: #666;
}

.hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
}

.btn-login-wrap {
  width: 100%;
  margin: 0;
}

.btn-login {
  display: block;
  width: 100%;
  margin: 0 !important;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #07C160, #05964a);
  border: none;
  padding: 0;
  box-sizing: border-box;
  text-align: center;
}

.btn-login::after {
  border: none;
}

.btn-login[disabled] {
  background: #a7f3d0;
  color: #fff;
}
