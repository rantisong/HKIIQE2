.page {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #F8FAFC;
}

.header {
  padding: 32rpx 32rpx 24rpx;
  background: rgba(255,255,255,0.5);
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  font-size: 0;
}

.title-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #000;
}

/* 分享图标紧贴标题；负边距抵消原生 button 左侧内边距 */
.title-share-wrap {
  display: inline-flex;
  align-items: center;
  margin-left: -120rpx;
}

/* 二维码图标靠右对齐屏幕边缘（在 header 的 padding 内） */
.title-qr-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  margin-right: -8rpx;
}

.title-share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 !important;
  width: auto;
  min-width: 0;
  height: auto;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 0;
}

.title-share-btn::after {
  border: none;
}

.title-share-btn-hover {
  opacity: 0.7;
}

.subtitle {
  font-size: 30rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 32rpx 32rpx;
}

.stat-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.stat-label {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: bold;
  display: block;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #000;
}

.leader-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 48rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.leader-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.leader-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: rgba(7, 193, 96, 0.1);
  flex-shrink: 0;
}

.leader-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #000;
}

.leader-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.leader-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #2563eb;
}

.leader-arrow {
  font-size: 44rpx;
  color: #07C160;
}

.members-section {
  padding: 0 32rpx 32rpx;
}

.members-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #94a3b8;
  letter-spacing: 2rpx;
  margin-bottom: 32rpx;
  display: block;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.member-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: #fff;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.member-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.member-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.member-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #000;
  display: block;
  margin-bottom: 16rpx;
}

.progress-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot.passed {
  background: #07C160;
  color: #fff;
}

.member-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.member-badge {
  font-size: 22rpx;
  font-weight: bold;
  color: #2563eb;
}

.member-arrow {
  font-size: 40rpx;
  color: #07C160;
}

.member-list.empty {
  padding: 48rpx;
  text-align: center;
}

.empty-text {
  color: #94a3b8;
  font-size: 28rpx;
}

/* 邀请二维码弹窗 */
.qr-save-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 400px;
  height: 480px;
}

.qr-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.qr-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  z-index: 101;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

.qr-modal-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #000;
  margin-bottom: 24rpx;
}

.qr-modal-image {
  display: block;
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
}

.qr-modal-scene-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 16rpx;
}

.qr-modal-loading {
  height: 400rpx;
  line-height: 400rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.qr-modal-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.qr-modal-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx;
  border-radius: 12rpx;
}

.qr-modal-btn.secondary {
  background: #f1f5f9;
  color: #64748b;
}

.qr-modal-btn.primary {
  background: #07C160;
  color: #fff;
}
