.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F5F5F5;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.section-account .account-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-account .account-row:last-of-type {
  margin-bottom: 0;
}

.account-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #334155;
  flex-shrink: 0;
}

/* 外层固定正方形 + 圆形裁剪，避免 button 默认样式导致变形 */
.account-avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.account-avatar-btn {
  padding: 0;
  margin: 0;
  width: 100%;
  height: 100%;
  background: none;
  border: none;
  border-radius: 0;
  display: block;
  line-height: 0;
}

.account-avatar-btn::after {
  border: none;
}

.account-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
  background: #f1f5f9;
  vertical-align: top;
}

.account-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #fff;
}

.require-phone-hint {
  font-size: 22rpx;
  font-style: italic;
  color: #dc2626;
  margin: 0 0 24rpx 0;
  padding: 24rpx 32rpx;
  background: #fef2f2;
  border-radius: 0;
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #000;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 20rpx;
  line-height: 1.5;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.error-block {
  padding: 20rpx;
  background: #fef2f2;
  color: #dc2626;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.form-row,
.form-row-display {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}

.form-row-display .btn-sm {
  flex: 1;
  min-width: 0;
}

.invite-display-box {
  flex: 2;
  min-width: 0;
  width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #fff;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.invite-display-text {
  display: block;
  width: 100%;
  font-size: 28rpx;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.form-input-wrap {
  flex: 2;
  min-width: 0;
  width: 0;
  height: 88rpx;
  overflow: hidden;
}

.form-input-wrap .input {
  width: 100%;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #fff;
  display: block;
}

.invite-placeholder {
  font-size: 22rpx;
  line-height: 88rpx;
  color: #94a3b8;
}

.form-row .btn-sm {
  flex: 1;
  min-width: 0;
}

.input {
  padding: 24rpx;
  font-size: 30rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.picker-value {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #334155;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.btn-sm {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  background: #07C160;
}

.save-row {
  margin-top: 24rpx;
}

.save-row .btn-sm {
  width: 100%;
  display: block;
  box-sizing: border-box;
}

.picker-value-placeholder {
  font-size: 22rpx;
  color: #94a3b8;
}

.btn-text {
  font-size: 28rpx;
  color: #64748b;
  background: none;
  padding: 0;
  margin: 0;
}

.btn-text::after {
  border: none;
}

.section-logout {
  padding: 0;
}

.logout-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}

.logout-item .menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.logout-item .menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.logout-item .menu-icon.red {
  background: #fee2e2;
}

.logout-item .menu-text {
  font-size: 30rpx;
}

.logout-item .menu-text.red {
  color: #ef4444;
}

.logout-item .menu-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
}
