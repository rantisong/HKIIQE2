.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F8FAFC;
}

.hint {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 24rpx;
}

.error-block {
  padding: 24rpx;
  background: #fef2f2;
  color: #dc2626;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.form {
  margin-top: 24rpx;
}

.input {
  width: 100%;
  padding: 24rpx;
  font-size: 32rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.btn {
  background: #07C160;
}
