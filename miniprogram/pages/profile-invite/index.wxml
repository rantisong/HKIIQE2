<view class="page">
  <view class="hint">填写新的邀请人邀请码后，您将加入该邀请人的团队。</view>
  <view class="error-block" wx:if="{{error}}">{{error}}</view>
  <view class="form">
    <input
      class="input"
      type="text"
      placeholder="请输入 6 位邀请码"
      value="{{inviteCode}}"
      maxlength="6"
      bindinput="onInput"
    />
    <button class="btn" type="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onConfirm">确认</button>
  </view>
</view>
