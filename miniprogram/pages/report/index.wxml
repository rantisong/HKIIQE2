<scroll-view scroll-y class="page hide-scrollbar" enhanced show-scrollbar="{{false}}">
  <view class="score-card">
    <view class="score-ring">
      <view class="score-value">{{fromExamResult ? scoreValue : (record && record.score != null ? record.score : '--')}}</view>
      <text class="score-label">TOTAL SCORE</text>
    </view>
    <view class="pass-badge {{passed ? '' : 'fail'}}">{{passed ? '🎉 考试通过 · 表现优异' : '未达到 70% 合格线'}}</view>
  </view>

  <view class="stats-grid">
    <view class="stat-item">
      <text class="stat-label">正确率</text>
      <text class="stat-value success">{{fromExamResult ? accuracyPercent + '%' : (record ? (record.accuracyPercent != null ? record.accuracyPercent + '%' : '--') : '--')}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">答题用时</text>
      <text class="stat-value">{{fromExamResult ? timeSpentText : (record && record.timeSpent != null ? record.timeSpentText : '--')}}</text>
    </view>
  </view>

  <view class="back-btn-wrap">
    <button class="back-btn" bindtap="onBack">返回练习首页</button>
  </view>
</scroll-view>
