.page {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #F5F5F5;
}

.profile-card {
  margin: 24rpx 32rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #07C160, #05964a);
  border-radius: 48rpx;
  color: #fff;
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.2);
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.reg-date {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  overflow: hidden;
}

.date-icon {
  font-size: 24rpx;
}

.date-text {
  font-size: 22rpx;
  opacity: 0.8;
}

.profile-settings-wrap {
  flex-shrink: 0;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-settings-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  font-size: 44rpx;
  box-shadow: none;
}

.qr-btn {
  padding: 20rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  font-size: 48rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 0 32rpx;
  margin-top: -8rpx;
}

.stat-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  min-height: 72rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 5rpx;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.stat-value {
  font-size: 34rpx;
  font-weight: bold;
}

.stat-unit {
  font-size: 24rpx;
  color: #888;
}

.menu-list {
  margin: 48rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.menu-icon.green {
  background: #dcfce7;
}

.menu-icon.red {
  background: #fee2e2;
}

.menu-text {
  font-size: 30rpx;
  color: #000;
}

.menu-text.red {
  color: #ef4444;
}

.menu-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
}

.exam-progress-section {
  margin: 32rpx;
}

.exam-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 20rpx 0;
}

.exam-progress-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #000;
}

.exam-progress-hint {
  font-size: 24rpx;
  color: #94a3b8;
}

.exam-progress-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  padding: 28rpx 32rpx;
}

.exam-progress-card:last-child {
  margin-bottom: 0;
}

.exam-card-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #2563eb;
  border-radius: 0 8rpx 8rpx 0;
}

.exam-card-bar.exam-card-bar-passed {
  background: #07C160;
}

.exam-card-inner {
  flex: 1;
  min-width: 0;
}

.exam-progress-card.has-time .exam-card-inner {
  margin-left: 16rpx;
}

.exam-card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.exam-card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #334155;
  flex: 1;
  min-width: 0;
}

.exam-countdown-badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  background: #93c5fd;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-countdown-badge-text {
  font-size: 22rpx;
  color: #1e40af;
}

.exam-countdown-badge.exam-badge-passed {
  background: #07C160;
}

.exam-countdown-badge.exam-badge-passed .exam-countdown-badge-text {
  color: #fff;
}

.exam-card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.exam-card-meta .md-icon {
  flex-shrink: 0;
}

.exam-meta-label {
  font-size: 26rpx;
  color: #64748b;
}

.exam-meta-time {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 500;
}

.exam-card-meta-passed .exam-meta-time {
  color: #94a3b8;
}

.exam-card-meta-unset {
  color: #94a3b8;
}

.exam-meta-placeholder {
  font-size: 26rpx;
  color: #94a3b8;
}

.exam-card-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.exam-passed-row {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #05964a;
}

.exam-passed-at {
  margin-left: 12rpx;
  color: #64748b;
}
