.profile-guest {
  min-height: calc(100vh - 180rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

.guest-card {
  width: 100%;
  background: #fff;
  border-radius: 48rpx;
  padding: 80rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}

.guest-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #000;
  display: block;
  margin-bottom: 56rpx;
}

.guest-desc {
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.6;
  display: block;
  margin-bottom: 40rpx;
}

.guest-invite-row {
  margin-bottom: 48rpx;
}

.guest-invite-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #000;
  box-sizing: border-box;
}

.guest-login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-login-btn[disabled] {
  background: #a7f3d0;
  color: #fff;
}

.profile-login-form {
  min-height: calc(100vh - 180rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

.profile-login-card {
  width: 100%;
  background: #fff;
  border-radius: 48rpx;
  padding: 80rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}

.profile-login-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #000;
  display: block;
  margin-bottom: 24rpx;
}

.profile-login-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  display: block;
  margin-bottom: 48rpx;
}

.profile-login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #07C160, #05964a);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  text-align: center;
}

.profile-login-btn::after {
  border: none;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #F5F5F5;
}

.profile-card {
  margin: 24rpx 32rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #07C160, #05964a);
  border-radius: 48rpx;
  color: #fff;
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  padding: 0;
}

.profile-info .name,
.profile-info .invite-share-row {
  margin-left: 0;
  padding-left: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.2);
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.reg-date {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  overflow: hidden;
}

.date-icon {
  font-size: 24rpx;
}

.date-text {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 邀请码+分享图标为一整行，点击整块调起分享；与昵称左对齐、白色不粗 */
.invite-share-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  overflow: hidden;
  margin: 0 !important;
  padding: 0 !important;
  min-width: 0;
  height: auto;
  line-height: inherit;
  background: transparent;
  border: none;
  border-radius: 0;
  text-align: left;
  align-self: flex-start;
  color: #fff;
  font-weight: normal;
  box-sizing: border-box;
}

.invite-share-row .date-text {
  color: #fff;
  font-weight: normal;
}

.invite-share-row::after {
  border: none;
}

/* 覆盖微信 button 默认左右内边距，保证与昵称 F 左对齐 */
.profile-info .invite-share-row {
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.invite-share-row-hover {
  opacity: 0.85;
}

/* 图标与邀请码文字同高：约 22rpx，用 scale 缩小（组件内部为 px 无法从外部改） */
.invite-share-icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  overflow: hidden;
}

.invite-share-icon-wrap > md-icon {
  transform: scale(0.52);
  transform-origin: center center;
}

.profile-settings-wrap {
  flex-shrink: 0;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-settings-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  font-size: 44rpx;
  box-shadow: none;
}

.qr-btn {
  padding: 20rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  font-size: 48rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 0 32rpx;
  margin-top: -8rpx;
}

.stat-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  min-height: 72rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 5rpx;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.stat-value {
  font-size: 34rpx;
  font-weight: bold;
}

.stat-unit {
  font-size: 24rpx;
  color: #888;
}

.menu-list {
  margin: 48rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.menu-icon.green {
  background: #dcfce7;
}

.menu-icon.red {
  background: #fee2e2;
}

.menu-text {
  font-size: 30rpx;
  color: #000;
}

.menu-text.red {
  color: #ef4444;
}

.menu-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
}
