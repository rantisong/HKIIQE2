<scroll-view scroll-y class="page hide-scrollbar" enhanced show-scrollbar="{{false}}">
  <view class="profile-card">
    <view class="profile-left">
      <image class="avatar" src="{{avatarDisplay}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="name">{{nicknameDisplay}}</text>
        <view class="reg-date">
          <text class="date-icon">🔑</text>
          <text class="date-text">邀请码 : {{inviteCodeDisplay}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="stats-grid">
    <view wx:for="{{stats}}" wx:key="label" class="stat-item">
      <text class="stat-label">{{item.label}}</text>
      <view class="stat-value-row">
        <text class="stat-value brand">{{item.value}}</text>
        <text class="stat-unit">{{item.unit}}</text>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="onIiqeRecords">
      <view class="menu-left">
        <view class="menu-icon green">📋</view>
        <text class="menu-text">真实考试记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onUpdateInvite">
      <view class="menu-left">
        <view class="menu-icon green">🔗</view>
        <text class="menu-text">修改被邀请码</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCustomerService">
      <view class="menu-left">
        <view class="menu-icon green">🎧</view>
        <text class="menu-text">在线客服</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onLogout">
      <view class="menu-left">
        <view class="menu-icon red">🚪</view>
        <text class="menu-text red">退出登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</scroll-view>
