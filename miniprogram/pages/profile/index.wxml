<scroll-view scroll-y class="page hide-scrollbar" enhanced show-scrollbar="{{false}}">
  <guest-hint />
  <view wx:if="{{isGuest}}" class="profile-guest">
    <view class="guest-card">
      <text class="guest-title">欢迎使用HKIIQE</text>
      <text class="guest-desc">注册/登录后可记录练习成绩、收藏题目复习、查看团队数据，获得完整学习体验</text>
      <view class="guest-invite-row">
        <input
          class="guest-invite-input"
          type="text"
          placeholder="请输入邀请码"
          value="{{guestInviteCode}}"
          maxlength="6"
          bindinput="onGuestInviteInput"
        />
      </view>
      <button class="guest-login-btn" disabled="{{guestInviteCode.length !== 6}}" bindtap="onGoLogin">注册/登录</button>
    </view>
  </view>
  <view wx:elif="{{showLoginForm}}" class="profile-login-form">
    <view class="profile-login-card">
      <text class="profile-login-title">欢迎使用 HKIIQE</text>
      <text class="profile-login-desc">请先完成微信头像与昵称授权，再进行登录或注册</text>
      <button class="profile-login-btn" bindtap="onGoToLoginPage">微信一键授权登录</button>
    </view>
  </view>
  <block wx:else>
  <view class="profile-card">
    <view class="profile-left">
      <image class="avatar" src="{{avatarDisplay}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="name">{{nicknameDisplay}}</text>
        <view class="reg-date">
          <text class="date-icon">🔑</text>
          <text class="date-text">邀请码 : {{inviteCodeDisplay}}</text>
        </view>
      </view>
    </view>
    <view class="profile-settings-wrap" bindtap="onSettings">
      <view class="profile-settings-btn">
        <md-icon name="edit_note" size="36" colorClass="white"/>
      </view>
    </view>
  </view>

  <view class="stats-grid">
    <view wx:for="{{stats}}" wx:key="label" class="stat-item">
      <text class="stat-label">{{item.label}}</text>
      <view class="stat-value-row">
        <text class="stat-value brand">{{item.value}}</text>
        <text class="stat-unit">{{item.unit}}</text>
      </view>
    </view>
  </view>

  <view class="exam-progress-section">
    <view class="exam-progress-header">
      <text class="exam-progress-title">考试进度</text>
    </view>
    <view
      wx:for="{{examProgressList}}"
      wx:key="subjectId"
      class="exam-progress-card {{item.hasExamTime || item.passed ? 'has-time' : ''}}"
      data-index="{{index}}"
      bindtap="onExamProgressItem"
    >
      <view class="exam-card-bar {{item.passed ? 'exam-card-bar-passed' : ''}}" wx:if="{{item.hasExamTime || item.passed}}"></view>
      <view class="exam-card-inner">
        <view class="exam-card-title-row">
          <text class="exam-card-name">卷{{item.subjectLabel}}：{{item.subjectName}}</text>
          <view class="exam-countdown-badge {{item.passed ? 'exam-badge-passed' : ''}}" wx:if="{{item.passed || (item.hasExamTime && item.countdownText)}}">
            <text class="exam-countdown-badge-text">{{item.passed ? '已通过' : item.countdownText}}</text>
          </view>
        </view>
        <view class="exam-card-meta exam-card-meta-passed" wx:if="{{item.passed}}">
          <md-icon name="event" size="16" colorClass="blue"/>
          <text class="exam-meta-label">通过日期 : </text>
          <text class="exam-meta-time">{{item.passedAt}}</text>
        </view>
        <view class="exam-card-meta" wx:elif="{{item.hasExamTime}}">
          <md-icon name="event" size="16" colorClass="blue"/>
          <text class="exam-meta-label">考试时间 : </text>
          <text class="exam-meta-time">{{item.examTimeDisplay}}</text>
        </view>
        <view class="exam-card-meta exam-card-meta-unset" wx:else>
          <md-icon name="add_circle_outline" size="18" colorClass="muted"/>
          <text class="exam-meta-placeholder">设置考试进度</text>
        </view>
      </view>
      <text class="exam-card-arrow">›</text>
    </view>
  </view>
  </block>
</scroll-view>
